# /opt/moshirag/moshirag.env on the GPU instance (mode 600). Copy: /root/esys/secrets/moshirag/.
# Retrieval LLM: self-hosted vLLM on the same GPU (deploy/run-llm.sh).
LLM_BASE_URL=http://127.0.0.1:8002/v1
LLM_MODEL_NAME=qwen3-14b
LLM_API_KEY=local
# Paid alternative (Anthropic's OpenAI-compatible API), kept on the instance as moshirag.env.anthropic:
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL_NAME=claude-haiku-5-5
# LLM_API_KEY=sk-ant-...
